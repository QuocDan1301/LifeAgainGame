{
  "name": "life-again-game",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/game-server.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "preview": "npm run build && node --env-file-if-exists=.env server/game-server.mjs --dist",
    "test:game-center": "node scripts/check-game-center-progress.mjs",
    "test:work": "node scripts/check-work-temptation.mjs && node scripts/check-crime.mjs",
    "test:auction": "node scripts/check-auction.mjs",
    "test:detective": "node scripts/check-detective.mjs",
    "test:garden": "node scripts/check-garden.mjs",
    "test:economy": "node scripts/check-taxes-housing.mjs && node scripts/check-economy-balance.mjs && node scripts/check-study-abroad.mjs",
    "test:economy:ui": "node scripts/run-economy-ui-check.mjs",
    "test:balance": "npm run test:economy && node scripts/check-wealth-reachability.mjs && node scripts/check-activity-reachability.mjs && node scripts/check-achievement-progress.mjs && node scripts/check-achievement-balance.mjs && node scripts/check-special-order.mjs && node scripts/audit-achievement-sources.mjs",
    "test:server": "node scripts/check-server.mjs && node scripts/check-installed-entry.mjs",
    "test:installation:ui": "node scripts/run-installation-ui-check.mjs",
    "test:offline": "node scripts/check-offline-updates.mjs",
    "test:family": "node scripts/check-family-conversations.mjs",
    "test:dating": "node scripts/check-dating-expenses.mjs",
    "check:deployment": "node --env-file-if-exists=.env scripts/check-deployment.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
