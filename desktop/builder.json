{
  "appId": "com.quocdan.lifeagain",
  "productName": "Life Again",
  "copyright": "Copyright © 2026 QuocDan",
  "directories": { "app": "desktop/app", "output": "output/windows-release" },
  "files": ["main.mjs", "runtime.mjs", "updater.mjs", "package.json", "icon.png", "game/**/*"],
  "asar": true,
  "npmRebuild": false,
